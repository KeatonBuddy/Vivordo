rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function circleNotBlocked(a, b) {
      return !exists(/databases/$(database)/documents/circle_blocks/$(a)/users/$(b))
          && !exists(/databases/$(database)/documents/circle_blocks/$(b)/users/$(a));
    }

    match /circle_blocks/{userId}/users/{blockedId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // ── User document + ALL subcollections ───────────────────────────────────
    // Subcollections covered: metrics_daily, preferences, questionnaire_responses,
    // insights, weekly_trends, insight_summaries, analytics_events,
    // recent_activities, workouts.
    // Only the owning user may read or write their own data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Circle profiles are visible to authenticated users so a reserved
      // friend code can resolve to the person it belongs to. Only the owner
      // may create or update their profile. Challenge medal totals are
      // server-awarded and cannot be changed by a client.
      match /circle/profile {
        allow read: if request.auth != null
                    && circleNotBlocked(request.auth.uid, userId);
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.get('challengeMedalCount', 0) == 0;
        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.get('challengeMedalCount', 0)
                         == resource.data.get('challengeMedalCount', 0);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /circle/relationships/friend_requests/{requesterId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid == requesterId
                      && circleNotBlocked(requesterId, userId)
                      && request.resource.data.fromUid == requesterId
                      && request.resource.data.toUid == userId;
        allow update: if false;
        allow delete: if request.auth != null
                      && (request.auth.uid == userId
                          || request.auth.uid == requesterId);
      }

      match /circle/relationships/friends/{friendId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.resource.data.uid == friendId
                      && circleNotBlocked(userId, friendId)
                      && (request.auth.uid == userId
                          || (request.auth.uid == friendId
                              && exists(/databases/$(database)/documents/users/$(friendId)/circle/relationships/friend_requests/$(userId))));
        allow update: if false;
        allow delete: if request.auth != null
                      && (request.auth.uid == userId
                          || request.auth.uid == friendId);
      }

      // A privacy-safe daily activity-ring summary. Friends can see only the
      // three ring totals and goals published here, never metrics_daily.
      match /circle_daily/{dayId} {
        allow read: if request.auth != null
                    && (request.auth.uid == userId
                        || (circleNotBlocked(userId, request.auth.uid) && exists(/databases/$(database)/documents/users/$(userId)/circle/relationships/friends/$(request.auth.uid))));
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // A Circle friend may read only the small activity summaries explicitly
      // published to the social feed. Full workouts and health metrics remain
      // private to their owner.
      match /circle_activity/{activityId} {
        allow read: if request.auth != null
                    && (request.auth.uid == userId
                        || (circleNotBlocked(userId, request.auth.uid) && exists(/databases/$(database)/documents/users/$(userId)/circle/relationships/friends/$(request.auth.uid))));
        allow write: if request.auth != null && request.auth.uid == userId;

        match /comments/{commentId} {
          allow read: if request.auth != null
                      && (request.auth.uid == userId
                          || (circleNotBlocked(userId, request.auth.uid) && exists(/databases/$(database)/documents/users/$(userId)/circle/relationships/friends/$(request.auth.uid))));
          allow create: if request.auth != null
                        && request.resource.data.authorUid == request.auth.uid
                        && request.resource.data.text is string
                        && request.resource.data.text.size() > 0
                        && request.resource.data.text.size() <= 500
                        && (request.auth.uid == userId
                            || (circleNotBlocked(userId, request.auth.uid) && exists(/databases/$(database)/documents/users/$(userId)/circle/relationships/friends/$(request.auth.uid))));
          allow update: if false;
          allow delete: if request.auth != null
                        && (request.auth.uid == userId
                            || resource.data.authorUid == request.auth.uid);
        }

        match /likes/{likeId} {
          allow read: if request.auth != null
                      && (request.auth.uid == userId
                          || (circleNotBlocked(userId, request.auth.uid) && exists(/databases/$(database)/documents/users/$(userId)/circle/relationships/friends/$(request.auth.uid))));
          allow create: if request.auth != null
                        && likeId == request.auth.uid
                        && request.resource.data.userUid == request.auth.uid
                        && (request.auth.uid == userId
                            || (circleNotBlocked(userId, request.auth.uid) && exists(/databases/$(database)/documents/users/$(userId)/circle/relationships/friends/$(request.auth.uid))));
          allow update: if false;
          allow delete: if request.auth != null && likeId == request.auth.uid;
        }
      }

      match /circle_engagement/{eventId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.resource.data.actorUid == request.auth.uid
                      && request.resource.data.type in ['like', 'comment']
                      && (circleNotBlocked(userId, request.auth.uid) && exists(/databases/$(database)/documents/users/$(userId)/circle/relationships/friends/$(request.auth.uid)));
        allow update: if false;
        allow delete: if request.auth != null
                      && (request.auth.uid == userId
                          || resource.data.actorUid == request.auth.uid);
      }

      // Achievement summaries are part of a Circle profile. Friends may read
      // them for featured badges and progress, while only the owner can write
      // or recalculate their achievement state.
      match /achievements/{achievementId} {
        allow read: if request.auth != null
                    && (request.auth.uid == userId
                        || (circleNotBlocked(userId, request.auth.uid) && exists(/databases/$(database)/documents/users/$(userId)/circle/relationships/friends/$(request.auth.uid))));
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Push tokens are private device credentials. Only the signed-in owner
      // can register or remove their devices; Cloud Functions uses Admin SDK
      // access to deliver Circle notifications.
      match /notification_tokens/{tokenId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      match /{subcollection}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // WHOOP access/refresh tokens and temporary OAuth state are backend-only.
    // Firebase Functions uses the Admin SDK, which bypasses these client rules.
    match /whoop_credentials/{userId} {
      allow read, write: if false;
    }

    match /whoop_oauth_states/{state} {
      allow read, write: if false;
    }

    match /circle_friend_codes/{friendCode} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && friendCode.size() == 10
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.uid == request.auth.uid;
    }

    match /circle_usernames/{username} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.uid == request.auth.uid;
    }

    // ── Circle challenges (Cloud Functions are the only writers) ────────────
    // The canonical challenge contains the complete participant list and is
    // readable only by those participants. All mutations flow through callable
    // functions so clients cannot forge invitations or progress.
    match /challenges/{challengeId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participantUids;
      allow create, update, delete: if false;

      match /participants/{participantId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/challenges/$(challengeId)).data.participantUids;
        allow write: if false;
      }

      match /contributions/{contributionId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/challenges/$(challengeId)).data.participantUids;
        allow write: if false;
      }

      // Accepted challenge participants can discuss the challenge in real time.
      // Comment authorship is immutable and users may delete only their own
      // comments.
      match /comments/{commentId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/challenges/$(challengeId)).data.acceptedUids;
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/challenges/$(challengeId)).data.acceptedUids
                      && request.resource.data.keys().hasOnly([
                        'authorUid',
                        'text',
                        'createdAt'
                      ])
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500
                      && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if request.auth != null
                      && resource.data.authorUid == request.auth.uid;
      }
    }

    // Per-user query mirror used by the Challenges screen. A user can see only
    // their own memberships; Cloud Functions keeps each mirror synchronized.
    match /challenge_memberships/{userId}/items/{challengeId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // Immutable proof of each challenge medal award. Cloud Functions creates
    // these records transactionally; users may inspect only their own history.
    match /challenge_medal_awards/{userId}/items/{challengeId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // ── AI batch tracking (written by Cloud Functions only) ──────────────────
    // Spans multiple users per nightly batch, so it stays top-level rather
    // than nested under a single user.
    match /batch_jobs/{batchId} {
      allow read: if request.auth != null;
    }

    // Private moderation inbox. Only authenticated friends who can see an
    // existing post may report it. Console/Admin SDK access handles triage.
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'type', 'reporterUid', 'postOwnerUid', 'postId', 'commentId',
          'commentAuthorUid', 'reason', 'details', 'status', 'createdAt'
        ])
        && request.resource.data.type == 'comment'
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.postOwnerUid is string
        && request.resource.data.postId is string
        && request.resource.data.commentId is string
        && request.resource.data.commentAuthorUid != request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.resource.data.postOwnerUid)/circle_activity/$(request.resource.data.postId)/comments/$(request.resource.data.commentId)).data.authorUid == request.resource.data.commentAuthorUid
        && circleNotBlocked(request.auth.uid, request.resource.data.postOwnerUid)
        && (request.auth.uid == request.resource.data.postOwnerUid
          || exists(/databases/$(database)/documents/users/$(request.resource.data.postOwnerUid)/circle/relationships/friends/$(request.auth.uid)))
        && request.resource.data.reason in ['harassment', 'inappropriate_content', 'spam', 'privacy', 'other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000
        && (request.resource.data.reason != 'other' || request.resource.data.details.size() > 0)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'type', 'reporterUid', 'profileOwnerUid', 'reason', 'details', 'status', 'createdAt'
        ])
        && request.resource.data.type == 'profile'
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.profileOwnerUid is string
        && request.resource.data.profileOwnerUid != request.auth.uid
        && circleNotBlocked(request.auth.uid, request.resource.data.profileOwnerUid)
        && exists(/databases/$(database)/documents/users/$(request.resource.data.profileOwnerUid)/circle/profile)
        && request.resource.data.reason in ['harassment', 'inappropriate_content', 'spam', 'privacy', 'other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000
        && (request.resource.data.reason != 'other' || request.resource.data.details.size() > 0)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'reporterUid', 'postOwnerUid', 'postId', 'reason', 'details', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'reporterUid', 'postOwnerUid', 'postId', 'reason', 'details', 'status', 'createdAt'
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.postOwnerUid is string
        && request.resource.data.postId is string
        && request.resource.data.postOwnerUid != request.auth.uid
        && request.resource.data.reason in ['harassment', 'inappropriate_content', 'spam', 'privacy', 'other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000
        && (request.resource.data.reason != 'other' || request.resource.data.details.matches('.*[^\\s].*'))
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.resource.data.postOwnerUid)/circle_activity/$(request.resource.data.postId))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.postOwnerUid)/circle/relationships/friends/$(request.auth.uid));
      allow read, update, delete: if false;
    }

    // ── Bug reports (written by the app from the Profile screen) ──────────────
    // Any signed-in user may submit a report. Reports are triaged via the
    // Firebase console / Cloud Functions, so clients may not read or modify
    // them — this keeps one user from seeing another's report. The new doc
    // must be stamped with the submitter's own uid.
    match /bug_reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
