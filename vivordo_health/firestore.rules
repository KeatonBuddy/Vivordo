rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── User document + ALL subcollections ───────────────────────────────────
    // Subcollections covered: metrics_daily, preferences, questionnaire_responses,
    // insights, weekly_trends, insight_summaries, analytics_events,
    // recent_activities, workouts.
    // Only the owning user may read or write their own data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Circle profiles are visible to authenticated users so a reserved
      // friend code can resolve to the person it belongs to. Only the owner
      // may create or update their profile.
      match /circle/profile {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /circle/relationships/friend_requests/{requesterId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid == requesterId
                      && request.resource.data.fromUid == requesterId
                      && request.resource.data.toUid == userId;
        allow update: if false;
        allow delete: if request.auth != null
                      && (request.auth.uid == userId
                          || request.auth.uid == requesterId);
      }

      match /circle/relationships/friends/{friendId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.resource.data.uid == friendId
                      && (request.auth.uid == userId
                          || (request.auth.uid == friendId
                              && exists(/databases/$(database)/documents/users/$(friendId)/circle/relationships/friend_requests/$(userId))));
        allow update: if false;
        allow delete: if request.auth != null
                      && (request.auth.uid == userId
                          || request.auth.uid == friendId);
      }

      // A privacy-safe daily activity-ring summary. Friends can see only the
      // three ring totals and goals published here, never metrics_daily.
      match /circle_daily/{dayId} {
        allow read: if request.auth != null
                    && (request.auth.uid == userId
                        || exists(/databases/$(database)/documents/users/$(userId)/circle/relationships/friends/$(request.auth.uid)));
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // A Circle friend may read only the small activity summaries explicitly
      // published to the social feed. Full workouts and health metrics remain
      // private to their owner.
      match /circle_activity/{activityId} {
        allow read: if request.auth != null
                    && (request.auth.uid == userId
                        || exists(/databases/$(database)/documents/users/$(userId)/circle/relationships/friends/$(request.auth.uid)));
        allow write: if request.auth != null && request.auth.uid == userId;

        match /comments/{commentId} {
          allow read: if request.auth != null
                      && (request.auth.uid == userId
                          || exists(/databases/$(database)/documents/users/$(userId)/circle/relationships/friends/$(request.auth.uid)));
          allow create: if request.auth != null
                        && request.resource.data.authorUid == request.auth.uid
                        && request.resource.data.text is string
                        && request.resource.data.text.size() > 0
                        && request.resource.data.text.size() <= 500
                        && (request.auth.uid == userId
                            || exists(/databases/$(database)/documents/users/$(userId)/circle/relationships/friends/$(request.auth.uid)));
          allow update: if false;
          allow delete: if request.auth != null
                        && (request.auth.uid == userId
                            || resource.data.authorUid == request.auth.uid);
        }

        match /likes/{likeId} {
          allow read: if request.auth != null
                      && (request.auth.uid == userId
                          || exists(/databases/$(database)/documents/users/$(userId)/circle/relationships/friends/$(request.auth.uid)));
          allow create: if request.auth != null
                        && likeId == request.auth.uid
                        && request.resource.data.userUid == request.auth.uid
                        && (request.auth.uid == userId
                            || exists(/databases/$(database)/documents/users/$(userId)/circle/relationships/friends/$(request.auth.uid)));
          allow update: if false;
          allow delete: if request.auth != null && likeId == request.auth.uid;
        }
      }

      match /circle_engagement/{eventId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.resource.data.actorUid == request.auth.uid
                      && request.resource.data.type in ['like', 'comment']
                      && exists(/databases/$(database)/documents/users/$(userId)/circle/relationships/friends/$(request.auth.uid));
        allow update: if false;
        allow delete: if request.auth != null
                      && (request.auth.uid == userId
                          || resource.data.actorUid == request.auth.uid);
      }

      // Push tokens are private device credentials. Only the signed-in owner
      // can register or remove their devices; Cloud Functions uses Admin SDK
      // access to deliver Circle notifications.
      match /notification_tokens/{tokenId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      match /{subcollection}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /circle_friend_codes/{friendCode} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && friendCode.size() == 10
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.uid == request.auth.uid;
    }

    match /circle_usernames/{username} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.uid == request.auth.uid;
    }

    // ── AI batch tracking (written by Cloud Functions only) ──────────────────
    // Spans multiple users per nightly batch, so it stays top-level rather
    // than nested under a single user.
    match /batch_jobs/{batchId} {
      allow read: if request.auth != null;
    }

    // ── Bug reports (written by the app from the Profile screen) ──────────────
    // Any signed-in user may submit a report. Reports are triaged via the
    // Firebase console / Cloud Functions, so clients may not read or modify
    // them — this keeps one user from seeing another's report. The new doc
    // must be stamped with the submitter's own uid.
    match /bug_reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
